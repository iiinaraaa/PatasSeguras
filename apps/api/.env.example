# Banco de dados (PostgreSQL — ex: Neon, Supabase, ou local)
DATABASE_URL="postgresql://user:password@localhost:5432/pets_platform?schema=public"

# JWT
JWT_ACCESS_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-valor-tambem-por-outra-string-aleatoria-longa"
JWT_REFRESH_EXPIRES_IN="30d"

# Cookies
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false" # true em produção (HTTPS obrigatório)

# Frontend (para CORS e links de e-mail)
FRONTEND_URL="http://localhost:3000"

# E-mail transacional (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Plataforma Pets <no-reply@seudominio.com>"

# Armazenamento de arquivos (Cloudflare R2 — compatível com S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# App
PORT=3001
NODE_ENV="development"
